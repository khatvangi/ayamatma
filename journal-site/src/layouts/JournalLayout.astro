---
import '../styles/base.css';
import '../styles/theme-zen.css';
import '../styles/journal.css';
import JournalNav from '../components/JournalNav.astro';

interface Props {
  title?: string;
  description?: string;
  lang?: string;
  image?: string;
  type?: string;
}

const {
  title = 'Ayamatma: Journal of Vedantic Studies',
  description = 'An independent open-access journal for Vedānta, Hindu philosophy, Sanskrit textual interpretation, Dharma, consciousness, and the science/philosophy dialogue.',
  lang = 'en',
  image = '/images/og-card.png',
  type = 'website',
} = Astro.props;

// standalone site: the journal is the root of its own domain, so the request
// path is already the canonical path.
const journalOrigin = 'https://ajvs.ayamatma.com';
const canonicalUrl = new URL(Astro.url.pathname, journalOrigin).href;
const ogImageUrl = image.startsWith('http') ? image : `${journalOrigin}${image}`;
const isHome = title === 'Ayamatma: Journal of Vedantic Studies';
const fullTitle = isHome ? title : `${title} · Ayamatma Journal`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="title" content={fullTitle} />
    <meta name="description" content={description} />
    <meta name="author" content="Ayamatma Press" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:site_name" content="Ayamatma: Journal of Vedantic Studies" />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <meta name="theme-color" content="#31518f" />

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": type === "article" ? "ScholarlyArticle" : "Periodical",
      "name": "Ayamatma: Journal of Vedantic Studies",
      "url": canonicalUrl,
      "description": description,
      "inLanguage": lang,
      "publisher": {
        "@type": "Organization",
        "name": "Ayamatma Press",
        "url": journalOrigin
      }
    })} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <header class="jl-masthead">
      <div class="container">
        <div class="nameplate">
          <a class="nameplate-brand" href="/" aria-label="Ayamatma: Journal of Vedantic Studies — home">
            <span class="nameplate-mark" aria-hidden="true">अ</span>
            <span class="nameplate-words">
              <span class="nameplate-title">Ayamatma</span>
              <span class="nameplate-sub">Journal of Vedantic Studies</span>
            </span>
          </a>
          <div class="nameplate-meta">
            <span>Open Access</span>
            <span>Est. 2026</span>
          </div>
        </div>
        <JournalNav path={Astro.url.pathname} />
      </div>
    </header>

    <main class="container page" id="main-content">
      <slot />
    </main>

    <footer class="jl-foot">
      <div class="container">
        <p class="colophon-mark" lang="sa">अयमात्मा ब्रह्म</p>
        <p><strong>Ayamatma: Journal of Vedantic Studies</strong> — published by Ayamatma Press.</p>
        <p class="muted">Open access. ISSN and DOIs are planned, not yet registered.</p>
        <p class="muted"><a href="https://ayamatma.com">ayamatma.com ↗</a></p>
      </div>
    </footer>
  </body>
</html>
