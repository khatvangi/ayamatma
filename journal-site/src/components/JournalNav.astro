---
interface Props {
  path?: string;
}
const { path = '' } = Astro.props;

const links = [
  { href: '/', label: 'Journal' },
  { href: '/about', label: 'About' },
  { href: '/aims-scope', label: 'Aims & Scope' },
  { href: '/editorial-board', label: 'Editorial Board' },
  { href: '/for-authors', label: 'For Authors' },
  { href: '/peer-review', label: 'Peer Review' },
  { href: '/publication-ethics', label: 'Ethics' },
  { href: '/open-access', label: 'Open Access' },
  { href: '/archives', label: 'Archives' },
  { href: '/cite', label: 'Cite' },
];

// active-state: normalize trailing slash, treat /articles/* under Archives
const here = path.replace(/\/$/, '') || '/';
const isActive = (href: string) =>
  href === '/' ? here === '/' : here === href || here.startsWith(href + '/');
---

<nav class="journal-nav" aria-label="Journal navigation">
  {links.map((link) => (
    <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>{link.label}</a>
  ))}
</nav>
