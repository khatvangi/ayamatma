---
import JournalLayout from '../../layouts/JournalLayout.astro';
import ShareButtons from '../../components/ShareButtons.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const articles = await getCollection('journal');
  return articles.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const a = entry.data;
const { Content, headings } = await entry.render();
const toc = headings.filter((h) => h.depth === 2);

const typeLabels = {
  'research-article': 'Research Article',
  'editor-reviewed-essay': 'Editor-Reviewed Essay',
  'translation-commentary': 'Translation & Commentary',
  'review-essay': 'Review Essay',
  dialogue: 'Dialogue',
  editorial: 'Editorial',
};

const statusLabels = {
  'peer-reviewed': 'Peer-reviewed',
  'editor-reviewed': 'Editor-reviewed',
  'signed-editorial': 'Signed editorial',
  'not-peer-reviewed': 'Not peer-reviewed',
};

// build a recommended citation if the article did not supply one
const authorList = a.authors.map((au) => au.name).join(', ');
const year = a.publishedDate.slice(0, 4);
const citation =
  a.citation ||
  `${authorList}. (${year}). ${a.title}. Ayamatma: Journal of Vedantic Studies, ${a.volume}(${a.issue}), Article ${a.articleNumber}.`;

const dateRows = [
  ['Received', a.receivedDate],
  ['Revised', a.revisedDate],
  ['Accepted', a.acceptedDate],
  ['Published', a.publishedDate],
].filter(([, v]) => v);
---

<JournalLayout title={`${a.title} | Ayamatma`} description={a.abstract} lang="en" type="article">
  <article class="article">
    <div class="masthead">
      <a href="/">Ayamatma: Journal of Vedantic Studies</a>
      <span class="dot">·</span>
      <span>Volume {a.volume}, Issue {a.issue}, Article {a.articleNumber}</span>
    </div>

    <header class="article-head">
      <div class="badges">
        <span class="pill pill-type">{typeLabels[a.articleType]}</span>
        <span class="pill pill-status">{statusLabels[a.reviewStatus]}</span>
      </div>
      <h1 class="article-title">{a.title}</h1>
      {a.subtitle ? <p class="article-subtitle">{a.subtitle}</p> : null}

      <div class="authors">
        {a.authors.map((au) => (
          <span class="author">
            <strong>{au.name}</strong>
            {au.affiliation ? <span class="muted"> — {au.affiliation}</span> : null}
            {au.orcid ? (
              <a class="orcid" href={`https://orcid.org/${au.orcid}`} rel="noopener">ORCID</a>
            ) : null}
          </span>
        ))}
      </div>
    </header>

    {a.adaptedFrom ? (
      <p class="adapted-note">
        {a.adaptedFrom.note ||
          `Adapted from an earlier Ayamatma essay${a.adaptedFrom.date ? ` published ${a.adaptedFrom.date}` : ''}. This journal version has been revised, expanded, and assigned formal metadata.`}
        {a.adaptedFrom.href ? (
          <> <a href={a.adaptedFrom.href}>View the original essay →</a></>
        ) : null}
      </p>
    ) : null}

    <section class="abstract">
      <h2 class="eyebrow">Abstract</h2>
      <p>{a.abstract}</p>
      {a.keywords?.length ? (
        <p class="keywords">
          <span class="kw-label">Keywords:</span> {a.keywords.join(' · ')}
        </p>
      ) : null}
    </section>

    <div class="article-body">
      <div class="prose article-content">
        <Content />
      </div>

      <aside class="article-info">
        {toc.length ? (
          <nav class="info-block">
            <div class="eyebrow">Contents</div>
            <ul class="toc">
              {toc.map((h) => (
                <li><a href={`#${h.slug}`}>{h.text}</a></li>
              ))}
            </ul>
          </nav>
        ) : null}

        <div class="info-block">
          <div class="eyebrow">Article information</div>
          <dl>
            <dt>Type</dt><dd>{typeLabels[a.articleType]}</dd>
            <dt>Review status</dt><dd>{statusLabels[a.reviewStatus]}</dd>
            {a.reviewPath ? <><dt>Review path</dt><dd>{a.reviewPath}</dd></> : null}
            {dateRows.map(([label, v]) => (
              <><dt>{label}</dt><dd>{v}</dd></>
            ))}
            <dt>License</dt><dd>{a.license}</dd>
            <dt>DOI</dt>
            <dd>
              {a.doiStatus === 'registered' && a.doi ? (
                <a href={`https://doi.org/${a.doi}`} rel="noopener">{a.doi}</a>
              ) : a.doiStatus === 'not-applicable' ? (
                'Not applicable'
              ) : (
                'Planned — not yet registered'
              )}
            </dd>
          </dl>
        </div>

        <div class="info-block cite-block">
          <div class="eyebrow">How to cite</div>
          <p class="citation">{citation}</p>
          <button class="cite-copy" data-copy-citation={citation}>Copy citation</button>
        </div>
      </aside>
    </div>

    <footer class="article-foot">
      <a class="back-link" href="/archives">← All articles</a>
      <ShareButtons text={a.abstract} />
    </footer>
  </article>
</JournalLayout>

<script is:inline>
  document.querySelectorAll('[data-copy-citation]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var text = btn.getAttribute('data-copy-citation');
      navigator.clipboard.writeText(text).then(function () {
        var original = btn.textContent;
        btn.textContent = 'Copied';
        setTimeout(function () {
          btn.textContent = original;
        }, 1500);
      });
    });
  });
</script>

<style>
  .article { max-width: 100%; }

  /* running head */
  .masthead {
    display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center;
    font-size: 0.66rem; text-transform: uppercase; letter-spacing: 0.14em;
    color: var(--muted); padding-bottom: 0.9rem; margin-bottom: 1.75rem;
    border-bottom: 1px solid var(--border);
  }
  .masthead a { color: var(--accent-warm); text-decoration: none; }
  .masthead a:hover { text-decoration: underline; }
  .masthead .dot { opacity: 0.4; }

  /* badges — flat small-caps markers, not pills */
  .badges { display: flex; flex-wrap: wrap; align-items: center; gap: 0.55rem; margin-bottom: 1.1rem; }
  .pill { font-size: 0.66rem; text-transform: uppercase; letter-spacing: 0.14em; font-weight: 600; }
  .pill-type { color: var(--accent-warm); }
  .pill-status { color: var(--accent-cool); }
  .pill + .pill::before { content: "·"; margin-right: 0.55rem; color: var(--border); font-weight: 400; }

  .article-title {
    font-family: 'Fraunces', Georgia, serif; font-weight: 600;
    font-size: clamp(2rem, 4.6vw, 3rem); line-height: 1.06; letter-spacing: -0.02em;
    margin: 0 0 0.55rem; color: var(--text); text-wrap: balance;
    font-variation-settings: 'opsz' 144;
  }
  .article-subtitle {
    font-family: 'Fraunces', Georgia, serif; font-style: italic; font-weight: 300;
    font-size: clamp(1.2rem, 2.5vw, 1.5rem); color: var(--text-soft); margin: 0 0 1.4rem;
  }

  .authors { font-size: 1rem; line-height: 1.65; padding-top: 0.9rem; border-top: 1px solid var(--border); }
  .author { display: block; }
  .author strong { font-weight: 600; color: var(--text); }
  .orcid { font-size: 0.68rem; margin-left: 0.45rem; color: var(--accent-cool); text-decoration: none; text-transform: uppercase; letter-spacing: 0.08em; }

  .adapted-note {
    margin: 1.6rem 0 0; padding: 0.2rem 0 0.2rem 1.1rem;
    border-left: 2px solid var(--accent-gold); background: transparent;
    font-size: 0.92rem; color: var(--text-soft); font-style: italic;
  }
  .adapted-note a { color: var(--accent-warm); font-style: normal; }

  /* abstract — ruled editorial block */
  .abstract { margin: 2.25rem 0; padding: 0 0 0 1.5rem; border-left: 2px solid var(--ink); max-width: 44rem; }
  .abstract .eyebrow { color: var(--ink); margin-bottom: 0.5rem; }
  .abstract p { margin: 0; color: var(--text-soft); line-height: 1.72; font-size: 1.05rem; }
  .keywords { margin: 1rem 0 0 !important; }
  .kw-label { text-transform: uppercase; letter-spacing: 0.12em; font-size: 0.64rem; font-weight: 600; color: var(--muted); }
  .keywords { font-size: 0.9rem; color: var(--muted); }

  .article-body {
    display: grid; grid-template-columns: minmax(0, 1fr) 15.5rem;
    gap: clamp(2rem, 5vw, 4rem); align-items: start;
  }
  .article-content { max-width: 40rem; }

  /* metadata sidebar — hairline rows, no boxes */
  .article-info { position: sticky; top: 1.5rem; display: grid; gap: 1.6rem; font-size: 0.82rem; }
  .info-block { border-top: 1px solid var(--text); padding-top: 0.8rem; }
  .info-block .eyebrow { margin-bottom: 0.7rem; font-size: 0.64rem; }
  .info-block dl { margin: 0; }
  .info-block dt { font-weight: 600; color: var(--muted); font-size: 0.6rem; text-transform: uppercase; letter-spacing: 0.1em; margin-top: 0.75rem; }
  .info-block dt:first-of-type { margin-top: 0; }
  .info-block dd { margin: 0.1rem 0 0; color: var(--text-soft); line-height: 1.45; }
  .info-block a { color: var(--accent-warm); }

  .toc { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.5rem; }
  .toc a { color: var(--text-soft); text-decoration: none; border-bottom: 1px solid transparent; }
  .toc a:hover { color: var(--ink); border-bottom-color: var(--ink); }

  .cite-block .citation { font-size: 0.82rem; line-height: 1.55; color: var(--text-soft); margin: 0 0 0.75rem; }
  .cite-copy {
    font-size: 0.62rem; text-transform: uppercase; letter-spacing: 0.1em; font-weight: 600;
    padding: 0.42rem 0.75rem; border: 1px solid var(--border); border-radius: 0;
    background: transparent; color: var(--text); cursor: pointer;
    transition: border-color 160ms ease, color 160ms ease;
  }
  .cite-copy:hover { border-color: var(--ink); color: var(--ink); }

  .article-foot {
    margin-top: 3.5rem; padding-top: 1.5rem; border-top: 1px solid var(--border);
    display: flex; flex-direction: column; gap: 1.25rem;
  }
  .back-link { color: var(--ink); text-decoration: none; font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.1em; font-weight: 600; }

  @media (max-width: 860px) {
    .article-body { grid-template-columns: 1fr; gap: 2rem; }
    .article-info { position: static; order: 2; }
  }
</style>
