---
import JournalLayout from '../layouts/JournalLayout.astro';
import { getCollection } from 'astro:content';

const typeLabels = {
  'research-article': 'Research article',
  'editor-reviewed-essay': 'Editor-reviewed essay',
  'translation-commentary': 'Translation & commentary',
  'review-essay': 'Review essay',
  dialogue: 'Dialogue',
  editorial: 'Editorial',
};

const published = (await getCollection('journal')).sort(
  (a, b) => b.data.articleNumber - a.data.articleNumber
);
const pad = (n) => String(n).padStart(2, '0');
const roman = (n) => ['', 'I', 'II', 'III', 'IV', 'V', 'VI', 'VII', 'VIII', 'IX', 'X'][n] || String(n);
const kicker = (d) =>
  d.series ? `${d.series.name}${d.series.part ? ` · ${roman(d.series.part)}` : ''}` : typeLabels[d.articleType];
---

<JournalLayout
  title="Ayamatma: Journal of Vedantic Studies"
  description="An independent open-access journal for Vedānta, Hindu philosophy, Sanskrit textual interpretation, Dharma, consciousness, and the science/philosophy dialogue."
>
  <section class="section stack">
    <p class="eyebrow">Volume 1 · Issue 1 · 2026</p>
    <p class="lead-statement">
      Disciplined inquiry into Vedānta, Hindu philosophy, and the honest boundary
      between tradition and modern knowledge.
    </p>
  </section>

  <section class="section">
    <div class="prose">
      <p>
        <strong>Ayamatma: Journal of Vedantic Studies</strong> is an independent open-access
        journal published by Ayamatma Press. Its purpose is not devotional promotion, academic
        fashion, or loose comparison between traditions — but disciplined inquiry: clear claims,
        transparent sources, careful reasoning, and respect for living traditions without
        surrendering critical standards.
      </p>
      <p>
        The journal uses continuous publication, with articles grouped into annual volumes and
        numbered issues. ISSN registration and article-level DOIs are planned once the publication
        structure and first issue are stable; no ISSN, DOI, indexing, or impact factor is claimed
        at this stage.
      </p>
    </div>
  </section>

  {published.length ? (
    <section class="section">
      <p class="issue-line">In this issue — Foundations</p>
      <h2 class="section-title">Volume 1, Issue 1</h2>
      <ul class="issue-toc">
        {published.map((a) => (
          <li>
            <a class="toc-entry" href={`/articles/${a.slug}`}>
              <span class="toc-num">{pad(a.data.articleNumber)}</span>
              <span class="toc-body">
                <span class="toc-kicker">{kicker(a.data)}</span>
                <span class="toc-title">{a.data.title}</span>
                <span class="toc-byline">{a.data.authors.map((au) => au.name).join(', ')}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
      <p style="margin-top:1.5rem;"><a class="cite-more" href="/archives">View full archive</a></p>
    </section>
  ) : null}

  <section class="section">
    <h2 class="section-title">What we publish</h2>
    <dl class="cat-list">
      <div class="cat-row">
        <dt><span class="cat-tag">Peer reviewed</span><span class="cat-name">Research Articles</span></dt>
        <dd>Substantial scholarly articles with explicit argument, sources, method, and independent review.</dd>
      </div>
      <div class="cat-row">
        <dt><span class="cat-tag">Editorially reviewed</span><span class="cat-name">Essays</span></dt>
        <dd>Analytical essays and interpretive reflections reviewed by the editor or an assigned editorial reader.</dd>
      </div>
      <div class="cat-row">
        <dt><span class="cat-tag">Textual work</span><span class="cat-name">Translations &amp; Commentaries</span></dt>
        <dd>Sanskrit passages, translations, and commentaries with source transparency and interpretive notes.</dd>
      </div>
      <div class="cat-row">
        <dt><span class="cat-tag">Critical review</span><span class="cat-name">Reviews &amp; Dialogues</span></dt>
        <dd>Book reviews, review essays, debates, interviews, and reflections clearly marked by review type.</dd>
      </div>
    </dl>
  </section>

  <section class="section">
    <div class="prose">
      <h2>Editorial responsibility</h2>
      <p>
        Editor-in-Chief: <strong>Kiran Boggavarapu</strong>, Professor of Chemistry &amp; Physics,
        McNeese State University. Publisher: <strong>Ayamatma Press</strong>.
      </p>
      <p>
        Submissions authored by the Editor-in-Chief are not treated as ordinary editor-reviewed work
        by the same editor alone. They require handling by an independent editorial reader or reviewer,
        and the article page discloses the review path.
      </p>
    </div>
  </section>
</JournalLayout>
