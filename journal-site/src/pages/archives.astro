---
import JournalLayout from '../layouts/JournalLayout.astro';
import { getCollection } from 'astro:content';

const lang = 'en';

const typeLabels = {
  'research-article': 'Research article',
  'scholarly-essay': 'Scholarly essay',
  'editor-reviewed-essay': 'Editor-reviewed essay',
  'translation-commentary': 'Translation & commentary',
  'review-essay': 'Review essay',
  dialogue: 'Dialogue',
  editorial: 'Editorial',
  vada: 'Vāda',
  lecture: 'Invited lecture',
  'oral-commentary': 'Oral commentary',
  'visual-essay': 'Visual essay',
  interview: 'Interview',
};

// published articles, newest article-number first within the issue
const published = (await getCollection('journal')).sort(
  (a, b) => b.data.articleNumber - a.data.articleNumber
);
---

<JournalLayout
  title="Archives"
  description="Journal archives for Ayamatma: A Journal of Vedantic Studies."
  lang={lang}
>
  <section class="section stack">
    <p class="eyebrow">Archives</p>
    <h1 class="section-title">Archives</h1>
    <p class="muted">
      Formal volumes and issues will appear here as the journal launches.
    </p>
  </section>

  <section class="section">
    <div class="prose">
      <h2>Volume 1, Issue 1 (2026): Foundations</h2>
      <p>
        The founding issue. Published contributions are listed below. The issue remains
        <strong>open for contributions</strong> — see <a href="/contribute">Contribute</a>.
      </p>
    </div>

    {published.length ? (
      <div class="stones">
        {published.map((art) => (
          <a class="card stone" href={`/articles/${art.slug}`}>
            <p class="eyebrow">
              {typeLabels[art.data.articleType]} · Article {art.data.articleNumber}
            </p>
            <h3>{art.data.title}</h3>
            <p class="muted">
              {art.data.authors.map((au) => au.name).join(', ')} · Published {art.data.publishedDate}
            </p>
          </a>
        ))}
      </div>
    ) : null}
  </section>

  <section class="section">
    <div class="prose">
      <p class="muted">
        <strong>Volume 1, Issue 1 — Foundations.</strong> Open for contributions.
        The next article number is open to an outside contributor.
      </p>
    </div>
  </section>
</JournalLayout>
