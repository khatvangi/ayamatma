---
import BaseLayout from '../../layouts/BaseLayout.astro';
import JournalNav from '../../components/JournalNav.astro';

const lang = 'en';
---

<BaseLayout
  title="Archives | Ayamatma"
  description="Journal archives for Ayamatma: Journal of Vedantic Studies."
  lang={lang}
>
  <section class="section stack">
    <p class="eyebrow">Archives</p>
    <h1 class="section-title">Archives</h1>
    <p class="muted">
      Formal volumes and issues will appear here as the journal launches.
    </p>
    <JournalNav />
  </section>

  <section class="section">
    <div class="prose">
      <h2>Volume 1, Issue 1 (2026): Foundations</h2>
      <p>
        This first issue is being prepared. The entries below are scaffold slots, not final published
        journal articles. Titles, authors, review status, and DOI metadata will be finalized only when
        each article has a stable landing page and publication record.
      </p>
    </div>

    <div class="stones">
      <article class="card stone">
        <p class="eyebrow">Founding editorial</p>
        <h3>Why Ayamatma Exists</h3>
        <p class="muted">Planned. Signed editorial. DOI not yet assigned.</p>
      </article>

      <article class="card stone">
        <p class="eyebrow">Research article</p>
        <h3>Ātman, Consciousness, and the Problem of Reduction</h3>
        <p class="muted">Planned. Review path to be determined. DOI not yet assigned.</p>
      </article>

      <article class="card stone">
        <p class="eyebrow">Conceptual essay</p>
        <h3>Dharma Is Not Religion</h3>
        <p class="muted">Planned. Editor-reviewed essay. DOI not yet assigned.</p>
      </article>

      <article class="card stone">
        <p class="eyebrow">Textual commentary</p>
        <h3>Ayam Ātmā Brahma: Text, Translation, and Implication</h3>
        <p class="muted">Planned. Translation/commentary. DOI not yet assigned.</p>
      </article>

      <article class="card stone">
        <p class="eyebrow">Review essay</p>
        <h3>Vedānta and Modern Knowledge: A Critical Review</h3>
        <p class="muted">Planned. Critical review. DOI not yet assigned.</p>
      </article>
    </div>
  </section>
</BaseLayout>
